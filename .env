## Docker Compose Settings.
### N.B. Docker Compose settings must be placed in your docker/.env as well ###
COMPOSE_PROJECT_NAME=training_project

# Override the default config split environment.
# DF_ENV_TYPE=local

## Change Drupal webroot folder from the default "web" folder (e.g. Acquia)
## This value needs to be set here and in your docker/.env file as well.
## DF_DRUPAL_WEBROOT=docroot

## Disable downloading of certain assets during npm install tasks.
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=true
